# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # New format (sb_publishable_*) — for Supabase JS client
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # Legacy JWT anon key (eyJ...) — for GraphQL/REST raw calls
DATABASE_SERVICE_ROLE=

# Database
# Local dev: use direct connection (postgres://postgres:...@db.<ref>.supabase.co:5432/postgres)
# Vercel/serverless: use TRANSACTION POOLER (port 6543) for IPv4 + connection pooling:
#   postgres://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
# Get URLs from: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=

# AWS S3
NEXT_PUBLIC_S3_BUCKET=
NEXT_PUBLIC_S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# STRIPE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECERT_KEY=

# Auth (GITHUB)
NEXT_PUBLIC_REACT_APP_GITHUB_AUTH_TOKEN=

# Deployment
NEXT_PUBLIC_SITE_URL=
